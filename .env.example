# Copie para .env.local (local) e coloque os mesmos valores no Vercel
# (Project → Settings → Environment Variables).

# Aiven → serviço PostgreSQL → "Service URI" (já inclui ?sslmode=require)
DATABASE_URL=postgres://avnadmin:PASSWORD@pg-xxxx.aivencloud.com:12345/defaultdb?sslmode=require

# Opcional: "CA certificate" do Aiven, para validar o certificado
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Texto aleatório e longo (ex.: `openssl rand -base64 32`). Assina as sessões do backoffice.
SESSION_SECRET=

# Só para o `npm run db:setup` (cria a conta da Ilde ou troca-lhe a palavra-passe).
# Não é preciso pôr no Vercel.
ADMIN_EMAIL=ildebranda@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Ilde
